# ==============================================================================
# 1. VARIÁVEIS PÚBLICAS DO FRONTEND (Vite)
# ==============================================================================
VITE_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="sua_chave_publica_anon_ou_publishable"

# ==============================================================================
# 2. SEGREDOS DO SERVIDOR — SUPABASE EDGE FUNCTION (r2-upload)
# ATENÇÃO: NUNCA adicione o prefixo VITE_ nestas variáveis!
# Configure no Supabase via CLI:
#   npx supabase secrets set \
#     R2_ACCOUNT_ID="..." \
#     R2_BUCKET_NAME="moradas-do-gabriel-images" \
#     R2_ACCESS_KEY_ID="..." \
#     R2_SECRET_ACCESS_KEY="..." \
#     R2_PUBLIC_URL="https://pub-xxxx.r2.dev" \
#     ALLOWED_ORIGINS="https://seudominio.com.br,http://localhost:5173"
# ==============================================================================
R2_ACCOUNT_ID=""
R2_BUCKET_NAME="moradas-do-gabriel-images"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL=""
ALLOWED_ORIGINS="http://localhost:5173"

